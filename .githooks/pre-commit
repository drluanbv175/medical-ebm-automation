#!/bin/sh
# Chan commit repo y khoa neu workspace Claude Code ↔ Codex con drift.
# Repo goc la nguon agent; repo nay la runtime cac cong. Hai ben phai cung dat
# tai moi moc hoan thien, khong duoc commit runtime trong khi doctrine con lech.

COMPLETION_SYNC_FAIL_CLOSED=1

# Cac script kiem tra deu IN tieng Viet. Tren Windows, stdout cua python mac dinh
# la cp1252 nen chi rieng viec in mot dong da nem UnicodeEncodeError -> hook ket
# luan "con lech" va CHAN COMMIT du khong co drift nao (03/08/2026, giong het loi
# da va o hook repo goc). Ep UTF-8; tren macOS/Linux khong doi gi.
export PYTHONUTF8=1
export PYTHONIOENCODING=utf-8

REPO_ROOT=$(git rev-parse --show-toplevel)
WORKSPACE_ROOT=${EBM_WORKSPACE_ROOT:-$(cd "$REPO_ROOT/.." && pwd)}
ROOT_HOOK="$WORKSPACE_ROOT/.githooks/pre-commit"
# Bo cuc ANH EM (phien Cloud: /home/user/medical-ebm-automation canh /home/user/EBM-drluanbv175) —
# 26/09/2026, cung thu tu do voi tools/goc_ebm.py. Chi thu khi KHONG dat EBM_WORKSPACE_ROOT va thu muc cha
# khong co hook; khong thay thi van CHAN nhu cu (khong noi long cong).
if [ -z "$EBM_WORKSPACE_ROOT" ] && [ ! -x "$ROOT_HOOK" ]; then
  for ten in EBM-drluanbv175 ebm-drluanbv175; do
    if [ -x "$REPO_ROOT/../$ten/.githooks/pre-commit" ]; then
      WORKSPACE_ROOT=$(cd "$REPO_ROOT/../$ten" && pwd)
      ROOT_HOOK="$WORKSPACE_ROOT/.githooks/pre-commit"
      break
    fi
  done
fi

if [ ! -x "$ROOT_HOOK" ]; then
  echo "CHAN COMMIT: khong tim thay hook dong bo workspace: $ROOT_HOOK" >&2
  echo "  Dat EBM_WORKSPACE_ROOT toi thu muc chua .claude/agents va .Codex/agents." >&2
  exit 1
fi

(
  # 12/09/2026: trong git worktree LIEN KET, git dat GIT_DIR/GIT_INDEX_FILE (va
  # cac bien GIT_* khac) tro vao thu muc quan tri cua CHINH worktree nay
  # (".../medical-ebm-automation/.git/worktrees/<ten>"). Cac bien do la bien moi
  # truong THAT, ke thua vao tien trinh con ROOT_HOOK ben duoi. Neu khong go bo,
  # lenh "git rev-parse --show-toplevel" O DAU ROOT_HOOK se doc theo GIT_DIR da
  # ro ri thay vi theo $PWD, tro NGUOC ve worktree medical-ebm-automation nay —
  # roi "cd" ve do, xoa het tac dung cua "cd $WORKSPACE_ROOT" vua lam. Ket qua:
  # moi kiem tra phia sau (dong bo .claude/agents/.Codex/agents/.codex/agents)
  # chay tren SAI thu muc, sinh canh bao "drift" hang loat khong lien quan gi
  # toi commit. Go cac bien nay de ROOT_HOOK tu dinh vi lai theo $PWD that.
  unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_PREFIX GIT_OBJECT_DIRECTORY
  cd "$WORKSPACE_ROOT" || exit 1
  "$ROOT_HOOK"
)
if [ "$?" -ne 0 ]; then
  echo "CHAN COMMIT repo y khoa: Claude Code ↔ Codex chua dong bo." >&2
  exit 1
fi

if ! command -v python3 >/dev/null 2>&1; then
  echo "CHAN COMMIT repo y khoa: khong tim thay python3 de kiem agent snapshot." >&2
  exit 1
fi

cd "$REPO_ROOT" || exit 1
python3 scripts/regenerate_agent_manifest.py --check
if [ "$?" -ne 0 ]; then
  echo "CHAN COMMIT: snapshot .claude/agents va manifest runtime con lech." >&2
  exit 1
fi

python3 tools/agent_gate_governance.py
if [ "$?" -ne 0 ]; then
  echo "CHAN COMMIT: governance agent/cong trong repo y khoa chua dat." >&2
  exit 1
fi

# Them 2026-07-31 sau su co that: commit a21a01f di qua TOAN BO cac chot tren
# sach hoan toan, trong khi file de cuong dang hong 26 cho — cac placeholder gia
# tri cua bang du kien ket qua ("n = —", "cOR = —") bi mot buoc xu ly van ban doi
# nham thanh dau phay. Moi chot phia tren chi kiem DONG BO agent/doctrine, khong
# co chot nao doc NOI DUNG tai lieu nghien cuu. Neu khong co nguoi doi chieu tay
# voi ban goc, ban hong da co the di thang vao tai lieu trinh Hoi dong Dao duc.
if [ -f tools/verify_exports_integrity.py ]; then
  python3 tools/verify_exports_integrity.py --staged
  if [ "$?" -ne 0 ]; then
    echo "" >&2
    echo "CHAN COMMIT: tai lieu nghien cuu trong exports/ co dau hieu hong noi dung." >&2
    echo "  Xem chi tiet o tren. Kiem lai mot file:" >&2
    echo "    python3 tools/verify_exports_integrity.py --path <duong-dan>" >&2
    echo "  Khan cap can bo qua: git commit --no-verify (KHONG khuyen nghi)." >&2
    exit 1
  fi
fi

# Them 02/10/2026 (PM-05, kiem toan dien): 14/29 luot CI y khoa do tu 14/09 la loi «Lint (ruff)» hoac «Bat bien newline vung
# chuoi-ky» — hai buoc CI chay < 2 giay nhung pre-commit chua chay (ngay 02/10 PR #65 do 4/4 vi dung loi newline). Chay CUNG lenh
# voi CI. May thieu ruff ⇒ ⚪ bo qua co thong bao (CI van chan), KHONG chan commit vi «khong do duoc» ≠ «loi».
RUFF=""
for ung in "$HOME/.ebm-venv/bin/ruff" "$HOME/.ebm-venv/Scripts/ruff.exe"; do
  if [ -x "$ung" ]; then RUFF="$ung"; break; fi
done
if [ -z "$RUFF" ] && command -v ruff >/dev/null 2>&1; then RUFF="ruff"; fi
if [ -n "$RUFF" ]; then
  if ! "$RUFF" check . -q; then
    echo "" >&2
    echo "CHAN COMMIT: ruff check . co loi (CI 'Lint (ruff)' se do). Sua: $RUFF check . --fix (xem lai thay doi)." >&2
    exit 1
  fi
else
  echo "⚪ pre-commit: may nay khong co ruff (~/.ebm-venv) — bo qua buoc lint; CI van chay 'ruff check .'." >&2
fi
if [ -f tools/kiem_newline_vung_ky.py ]; then
  if ! python3 tools/kiem_newline_vung_ky.py >/dev/null 2>&1; then
    python3 tools/kiem_newline_vung_ky.py >&2
    echo "CHAN COMMIT: bat bien newline vung chuoi-ky (CI cung chan) — them newline='\\n' cho write_text/open o dong bao do." >&2
    exit 1
  fi
fi

# Them 03/10/2026 (AN-06): chot bi mat/PII cho phan da stage CUA REPO Y KHOA. Hook goc o tren chay voi cwd = repo goc nen chi quet
# phan stage cua repo GOC. Cong cu o repo goc (mot nguon duy nhat), quet repo nay qua --repo. Vang cong cu ⇒ ⚪ bao, KHONG chan.
BIMAT="${WORKSPACE_ROOT:-}/tools/kiem_bi_mat_truoc_commit.py"
if [ -n "${WORKSPACE_ROOT:-}" ] && [ -f "$BIMAT" ]; then
  if ! python3 "$BIMAT" --repo "${REPO_ROOT:-$(pwd)}"; then
    echo "CHAN COMMIT: chot bi mat/PII — go khoa/token khoi phan da stage; khoa GIA trong test thi them 'bimat-mien: <ly do>' tren CHINH dong do." >&2
    exit 1
  fi
else
  echo "⚪ pre-commit: chua co tools/kiem_bi_mat_truoc_commit.py o repo goc (${WORKSPACE_ROOT:-?}) — bo qua chot bi mat/PII cua repo y khoa." >&2
fi

exit 0
