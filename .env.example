APP_ENV=local
APP_TIMEZONE=Asia/Ho_Chi_Minh

DATABASE_URL=sqlite:///data/medical_ebm.db

# NCBI / PubMed (E-utilities) - email bắt buộc, API key tùy chọn (tăng rate limit)
NCBI_API_KEY=
NCBI_EMAIL=

SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_EMAIL=
UNPAYWALL_EMAIL=

ZOTERO_API_KEY=
ZOTERO_LIBRARY_ID=
ZOTERO_LIBRARY_TYPE=user

NICE_API_KEY=

# Scopus (Elsevier) — đòi API key THẬT SỰ bắt buộc (khác các nguồn trên, không
# chạy được "không key ở QPS thấp" như Semantic Scholar). SCOPUS_INSTTOKEN tùy
# chọn, chỉ cần nếu đơn vị cấp institutional token.
SCOPUS_API_KEY=
SCOPUS_INSTTOKEN=
# Tùy chọn, CHỈ macOS: nếu VPN toàn tuyến cá nhân đang bật và Cloudflare chặn
# 403 request tới api.elsevier.com (xác nhận 13/09/2026 — xem CLAUDE.md mục
# "Nguồn dữ liệu"), đặt tên card mạng vật lý (vd "en1", xem `ifconfig`) để ép
# RIÊNG Scopus thoát qua card đó, bỏ qua route VPN, trong khi mọi thứ khác vẫn
# đi qua VPN như bình thường. Để trống nếu không dùng VPN toàn tuyến hoặc đang
# ở Windows.
SCOPUS_BIND_INTERFACE=

# CORE API (core.ac.uk) — đăng ký MIỄN PHÍ, TỰ ĐỘNG qua email, không cần duyệt:
# https://core.ac.uk/services/api (chỉ nhập email, key gửi ngay). Không bắt buộc
# như Scopus — vẫn gọi được ở nhịp thấp nếu để trống.
CORE_API_KEY=

# Epistemonikos API — KHÔNG tự đăng ký được, phải gửi email xin cấp token tới
# dev@epistemonikos.org (xem app/sources/epistemonikos.py). Bắt buộc như Scopus.
EPISTEMONIKOS_API_TOKEN=

# Wiley Text and Data Mining (TDM) API — KHÔNG phải nguồn tìm kiếm, chỉ TẢI TOÀN VĂN
# PDF theo DOI ĐÃ BIẾT (xem app/sources/wiley_tdm.py). Token là UUID lấy từ trang
# "Text and Data Mining" trong tài khoản Wiley Online Library — KHÔNG dán vào file này
# (đây là file MẪU, có trong git); dán trực tiếp vào ~/.ebm-secrets/medical-ebm-automation.env.
# ⚠️ Quyền truy cập bài KHÔNG PHẢI Open Access phụ thuộc DẢI IP mà tài khoản WOL được cấp
# — token đúng vẫn có thể bị ACCESS_DENIED nếu gọi ngoài dải IP đó.
WILEY_TDM_API_TOKEN=
# Để trống dùng mặc định "downloads_wiley_tdm" (thư mục làm việc hiện tại).
WILEY_TDM_DOWNLOAD_DIR=
# Giây nghỉ giữa các lượt tải hàng loạt (thư viện mặc định 5.0; Wiley khuyến nghị 10.0
# cho việc dùng liên tục — trần công bố ~3 bài/giây, 60 request/10 phút).
WILEY_TDM_RATE_LIMIT_SECONDS=10.0

# Connector TẢI TOÀN VĂN guideline trực tiếp từ website hiệp hội chuyên ngành — thêm
# 23/09/2026 (app/sources/gold_copd.py, gina_asthma.py, bts_guidelines.py,
# pmc_guideline_fulltext.py). KHÔNG cần API key nào — chỉ cần bật cờ. Mặc định TẮT — bật là
# quyết định của bác sĩ. Kiểm sống 24/09/2026: GOLD 2026 v1.3 · GINA 2026 · PMC (S3) tải được.
# Dùng qua lệnh: python3 tools/toan_van_guideline.py gold|gina|pmc <PMCID>|bts <URL> [--tim "<cụm từ>"]
# Trên phiên CLOUD không có ~/.ebm-secrets/: đặt các biến này ở cài đặt môi trường Cloud rồi mở phiên mới.
ENABLE_GOLD_COPD_FULLTEXT=false
ENABLE_GINA_ASTHMA_FULLTEXT=false
ENABLE_BTS_GUIDELINES_FULLTEXT=false
ENABLE_PMC_GUIDELINE_FULLTEXT=false
# (Tuỳ chọn) gốc repo EBM cho tools/verify_evidence_surveillance_deployment.py khi không nằm ở bố cục lồng
# (thư mục cha của engine) hay anh em (../EBM-drluanbv175). Để trống = tự dò; không thấy ⇒ «chưa đo được».
EBM_REPO_ROOT=

# BẬC THANG DỰ PHÒNG CÓ CỔNG (thêm 20/09/2026) — Consensus rồi SerpApi Google Scholar; CHỈ chạy khi nguồn chính
# thống chưa đủ bài đáng tin (xem app/services/fallback_ladder.py). Điền khoá bằng nút double-click ở thư mục gốc
# ("Nhap Khoa SerpApi.command", "Nhap Khoa Consensus.command") — KHÔNG dán khoá vào file này (đây là file MẪU, có trong git).
# SerpApi: mỗi search là MỘT lượt tính phí (gói Free 250/tháng).
SERPAPI_API_KEY=
# Consensus: khoá REST API tạo ở consensus.app → "API & MCP Dashboard" → "Keys and clients". Kết nối MCP KHÔNG phải
# khoá API. Gói Free 30 lượt/tháng dùng CHUNG với MCP nên có trần riêng bên dưới.
CONSENSUS_API_KEY=

# Bật/tắt từng nguồn. Nếu không có API key, nguồn vẫn chạy ở chế độ mock.
ENABLE_PUBMED=true
ENABLE_EUROPE_PMC=true
ENABLE_CROSSREF=true
ENABLE_OPENALEX=true
ENABLE_SEMANTIC_SCHOLAR=true
ENABLE_UNPAYWALL=true
ENABLE_CLINICALTRIALS=true
ENABLE_OPENFDA=true
ENABLE_ZOTERO=false
ENABLE_NICE=false
# Mặc định TẮT: bật CHỈ SAU KHI đã điền SCOPUS_API_KEY ở trên, nếu không
# search() sẽ chủ động báo lỗi rõ ràng thay vì âm thầm trả rỗng/mock.
ENABLE_SCOPUS=false
# CORE API — không bắt buộc CORE_API_KEY (vẫn chạy nhịp thấp không key), nhưng
# mặc định TẮT như Scopus/NICE để việc bật là lựa chọn tường minh.
ENABLE_CORE=false
# Epistemonikos — bắt buộc EPISTEMONIKOS_API_TOKEN thật (chặn cứng như Scopus).
ENABLE_EPISTEMONIKOS=false
# Wiley TDM API — bắt buộc WILEY_TDM_API_TOKEN thật (chặn cứng như Scopus). KHÔNG tham
# gia vòng quét song song (không phải nguồn tìm kiếm) — chỉ cần bật khi có quy trình
# chủ động tải PDF theo DOI qua WileyTdmClient hoặc `python run.py wiley-tdm-test <DOI>`.
ENABLE_WILEY_TDM=false
# Bậc thang dự phòng: mặc định TẮT (bật bằng nút 'Bat Tat SerpApi Du Phong.command' SAU khi đã có khoá và đã kiểm thật).
ENABLE_CONSENSUS=false
ENABLE_SERPAPI_SCHOLAR=false
# Thứ tự thử các tầng dự phòng (tên lạ ⇒ lỗi rõ ràng); chỉ tầng có cờ bật ở trên mới chạy.
FALLBACK_ORDER=consensus,serpapi_scholar
# Một truy vấn "đủ chứng cứ" khi có >= N bài đáng tin (PMID/DOI, tier != D) với điểm chứng cứ >= ngưỡng.
FALLBACK_MIN_TRUSTED=3
FALLBACK_MIN_EVIDENCE=60
# false (mặc định) = bản ghi dự phòng KHÔNG xác minh được ở Crossref/PubMed thì bỏ; true = giữ kèm cờ chua_xac_minh.
FALLBACK_KEEP_UNVERIFIED=false
# Trần gọi: SerpApi theo lượt chạy; Consensus theo THÁNG (bền, ghi file) và theo lượt chạy.
SERPAPI_MAX_CALLS_PER_RUN=8
# Trần THÁNG của SerpApi, bền qua các tiến trình (gói Free 250/tháng; 200 chừa phần cho chạy tay).
SERPAPI_MAX_CALLS_PER_MONTH=200
CONSENSUS_MAX_CALLS_PER_MONTH=10
CONSENSUS_MAX_CALLS_PER_RUN=5
CONSENSUS_LOOKBACK_YEARS=10
# Scite công khai (không cần khoá) — chỉ kiểm rút bài/thông báo biên tập cho bản ghi do tầng dự phòng tìm ra.
ENABLE_SCITE_VERIFICATION=true

# RSS feed an toàn thuốc thật (FDA MedWatch/Recalls, MHRA Drug Safety Update) & guideline (CDC MMWR, NEJM)
ENABLE_DRUG_SAFETY_FEEDS=true
ENABLE_GUIDELINE_FEEDS=true

# --- Gửi cảnh báo khi có mục MỚI ưu tiên cao ---
# Email (SMTP). Bỏ trống = không gửi (chỉ ghi file báo cáo).
ENABLE_EMAIL_ALERTS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=
SMTP_USE_TLS=true

# Webhook (Slack/Telegram/n8n…). Bỏ trống = không gửi.
ALERT_WEBHOOK_URL=

# Nếu true: không gọi mạng thật, mọi nguồn dùng mock adapter (an toàn cho test/demo offline)
USE_MOCK_SOURCES=true

REPORT_LANGUAGE=vi
MIN_EVIDENCE_SCORE=70
MIN_PRACTICE_CHANGE_SCORE=60

# HTTP client
HTTP_TIMEOUT=30
HTTP_MAX_RETRIES=4
HTTP_BACKOFF_FACTOR=1.5
HTTP_CACHE_TTL=86400

# ----- Tự sinh nội dung TikTok trong lịch nền (mặc định TẮT) -----
# Bật để daily_update / scheduler tự dựng gói nội dung TikTok (vẫn CHỜ bác duyệt rồi tự đăng).
ENABLE_TIKTOK_AUTO=false
TIKTOK_AUTO_COUNT=3
TIKTOK_AUTO_VIDEO=false
# Giọng đọc tiếng Việt cho video (macOS 'say'); đổi nếu muốn giọng khác:
# TIKTOK_TTS_VOICE=Linh
